float dot(const float*a,const float*b,int n){float z=0;for(int i=0;i<n;i++)z+=a[i]*b[i];return z;} void rms(float*o,const float*x,const float*w,int n){float z=0;for(int i=0;i<n;i++)z+=x[i]*x[i];z=1/sqrtf(z/n+1e-5f);for(int i=0;i<n;i++)o[i]=x[i]*z*w[i];} void mm(float*o,const float*x,const float*w,int n,int d){for(int i=0;i<d;i++)o[i]=dot(w+(size_t)i*n,x,n);} void soft(float*x,int n){float mx=x[0],sum=0;for(int i=1;i<n;i++)if(x[i]>mx)mx=x[i];for(int i=0;i<n;i++){x[i]=expf(x[i]-mx);sum+=x[i];}for(int i=0;i<n;i++)x[i]/=sum;}
