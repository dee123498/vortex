bool loadModel(){if(!sdOK)return false;File f=SD.open(MODEL);if(!f)return false;size_t n=f.size();m.blob=(uint8_t*)A(n);if(!m.blob){f.close();return false;}if(f.read(m.blob,n)!=n){f.close();return false;}f.close();memcpy(&m.c,m.blob,28);if(m.c.vocab!=256||m.c.dim<=0||m.c.hidden<=0)return false;float*p=(float*)(m.blob+28);int d=m.c.dim,h=m.c.hidden,L=m.c.layers,head=d/m.c.heads,kv=d*m.c.kvheads/m.c.heads;m.w.emb=p;p+=(size_t)256*d;m.w.r1=p;p+=(size_t)L*d;m.w.q=p;p+=(size_t)L*d*d;m.w.k=p;p+=(size_t)L*d*kv;m.w.v=p;p+=(size_t)L*d*kv;m.w.o=p;p+=(size_t)L*d*d;m.w.r2=p;p+=(size_t)L*d;m.w.w1=p;p+=(size_t)L*d*h;m.w.w2=p;p+=(size_t)L*h*d;m.w.w3=p;p+=(size_t)L*d*h;m.w.rf=p;p+=d;p+=(size_t)m.c.seq*head/2;p+=(size_t)m.c.seq*head/2;m.w.cls=p;if(!state())return false;memset(m.s.kc,0,(size_t)L*m.c.seq*kv*4);memset(m.s.vc,0,(size_t)L*m.c.seq*kv*4);m.loaded=true;return true;}
bool loadTok(){if(!sdOK)return false;File f=SD.open(TOK);if(!f)return false;uint32_t max; if(f.read((uint8_t*)&max,4)!=4){f.close();return false;}vocab=(char**)A(256*sizeof(char*));if(!vocab){f.close();return false;}for(int i=0;i<256;i++){float score;uint32_t len;if(f.read((uint8_t*)&score,4)!=4||f.read((uint8_t*)&len,4)!=4){f.close();return false;}vocab[i]=(char*)A(len+1);if(!vocab[i]||f.read((uint8_t*)vocab[i],len)!=len){f.close();return false;}vocab[i][len]=0;}f.close();return true;}
float* forward(int token,int pos){int d=m.c.dim,h=m.c.hidden,L=m.c.layers,head=d/m.c.heads,kv=d*m.c.kvheads/m.c.heads,mul=m.c.heads/m.c.kvheads;memcpy(m.s.x,m.w.emb+(size_t)token*d,d*4);for(int l=0;l<L;l++){rms(m.s.xb,m.s.x,m.w.r1+(size_t)l*d,d);mm(m.s.q,m.s.xb,m.w.q+(size_t)l*d*d,d,d);mm(m.s.k,m.s.xb,m.w.k+(size_t)l*d*kv,d,kv);mm(m.s.v,m.s.xb,m.w.v+(size_t)l*d*kv,d,kv);for(int hh=0;hh<m.c.heads;hh++)for(int i=0;i<head;i+=2){float fr=1/powf(10000,(float)i/head),a=pos*fr,c=cosf(a),s=sinf(a);float*q=m.s.q+hh*head,q0=q[i],q1=q[i+1];q[i]=q0*c-q1*s;q[i+1]=q0*s+q1*c;if(hh<m.c.kvheads){float*k=m.s.k+hh*head,k0=k[i],k1=k[i+1];k[i]=k0*c-k1*s;k[i+1]=k0*s+k1*c;}}size_t off=(size_t)l*m.c.seq*kv;memcpy(m.s.kc+off+(size_t)pos*kv,m.s.k,kv*4);memcpy(m.s.vc+off+(size_t)pos*kv,m.s.v,kv*4);for(int hh=0;hh<m.c.heads;hh++){float*q=m.s.q+hh*head,*a=m.s.att+hh*m.c.seq;for(int t=0;t<=pos;t++)a[t]=dot(q,m.s.kc+off+(size_t)t*kv+(hh/mul)*head,head)/sqrtf(head);soft(a,pos+1);float*xb=m.s.xb+hh*head;memset(xb,0,head*4);for(int t=0;t<=pos;t++){float*v=m.s.vc+off+(size_t)t*kv+(hh/mul)*head;for(int i=0;i<head;i++)xb[i]+=a[t]*v[i];}}mm(m.s.xb2,m.s.x,m.w.o+(size_t)l*d*d,d,d);for(int i=0;i<d;i++)m.s.x[i]+=m.s.xb2[i];rms(m.s.xb,m.s.x,m.w.r2+(size_t)l*d,d);mm(m.s.hb,m.s.xb,m.w.w1+(size_t)l*d*h,d,h);mm(m.s.hb2,m.s.xb,m.w.w3+(size_t)l*d*h,d,h);for(int i=0;i<h;i++)m.s.hb[i]=(m.s.hb[i]/(1+expf(-m.s.hb[i])))*m.s.hb2[i];mm(m.s.xb2,m.s.hb,m.w.w2+(size_t)l*h*d,h,d);for(int i=0;i<d;i++)m.s.x[i]+=m.s.xb2[i];}rms(m.s.x,m.s.x,m.w.rf,d);mm(m.s.logits,m.s.x,m.w.cls,d,256);return m.s.logits;}
